{
  "name": "@model-graph-tools/mcp-server",
  "version": "0.12.4",
  "description": "MCP server for querying the WildFly management model graph",
  "keywords": [
    "jboss",
    "management-model",
    "mcp",
    "model-context-protocol",
    "neo4j",
    "wildfly"
  ],
  "homepage": "https://model-graph-tools.github.io/",
  "bugs": {
    "url": "https://github.com/model-graph-tools/claude-plugin/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Harald Pehl",
    "email": "harald.pehl@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/model-graph-tools/claude-plugin.git",
    "directory": "mcp-server"
  },
  "bin": {
    "model-graph-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "start": "node dist/index.js",
    "dev": "vpx src/index.ts",
    "test": "vp test run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "neo4j-driver": "^6.3.2"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@model-graph-tools/mgt-darwin-arm64": "0.5.10",
    "@model-graph-tools/mgt-darwin-x64": "0.5.10",
    "@model-graph-tools/mgt-linux-arm64": "0.5.10",
    "@model-graph-tools/mgt-linux-x64": "0.5.10",
    "@model-graph-tools/mgt-win32-x64": "0.5.10"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
